{
  "name": "alis-frontend",
  "private": true,
  "type": "module",
  "version": "0.2.0-s4",
  "description": "ALIS 评分内核(S2) + 采集界面(S4)。逻辑在状态机，LLM 只碰语言。UI 离线可用，追问经后端 S3 渲染。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
